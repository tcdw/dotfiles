if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# direnv
if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

# brew keg-only toolchains; `brew --prefix` costs ~100ms, interactive shells only
if command -v brew >/dev/null 2>&1; then
  for _formula in ruby openjdk@17; do
    _prefix="$(brew --prefix "$_formula" 2>/dev/null)"
    if [ -n "$_prefix" ] && [ -d "$_prefix/bin" ]; then
      case ":$PATH:" in
        *":$_prefix/bin:"*) ;;
        *) PATH="$_prefix/bin:$PATH" ;;
      esac
    fi
  done
  unset _formula _prefix
fi

# jenv
if command -v jenv >/dev/null 2>&1; then
  eval "$(jenv init -)"
fi

if [[ -o interactive ]]; then
  export GPG_TTY="$(tty 2>/dev/null)"
fi

ulimit -n 65536 2>/dev/null || true

# gem user bin; `gem environment` costs ~200ms, so interactive shells only
if command -v gem >/dev/null 2>&1; then
  _gemdir="$(gem environment gemdir 2>/dev/null)"
  if [ -n "$_gemdir" ] && [ -d "$_gemdir/bin" ]; then
    case ":$PATH:" in
      *":$_gemdir/bin:"*) ;;
      *) PATH="$_gemdir/bin:$PATH" ;;
    esac
  fi
  unset _gemdir
fi

# Timidity configuration to use GeneralUser-GS soundfont by default
if [ -f "$HOME/.timidity/timidity.cfg" ]; then
  export TIMIDITY_CONFIG="$HOME/.timidity/timidity.cfg"
  alias timidity='timidity -c ~/.timidity/timidity.cfg'
fi

# yt-dlp with local browser cookies + all subs
alias yt-dlp='yt-dlp --all-subs'

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# machine-local secrets only (never commit this file)
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
