# secrets stay machine-local:
# - macOS: Keychain item omp.<provider>.api-key
# - Windows: user env <PROVIDER>_API_KEY (set once; not per-shell)
# - other: env <PROVIDER>_API_KEY
#
# oproxy: OpenAI-compatible third-party relay (https://api.oproxy.world/v1)
# Model limits/costs/capabilities filled from models.dev + pi-catalog metadata.
providers:
  longcat:
    baseUrl: https://api.longcat.chat/openai/v1
{{- if eq .chezmoi.os "darwin" }}
    apiKey: "!security find-generic-password -a \"$USER\" -s omp.longcat.api-key -w"
{{- else }}
    apiKey: LONGCAT_API_KEY
{{- end }}
    api: openai-completions
    authHeader: true
    discovery:
      type: openai-models-list
    models:
      - id: LongCat-2.0
        name: LongCat-2.0
        reasoning: true
        input: [text]
        contextWindow: 1048576
        maxTokens: 131072
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0

  openai:
    baseUrl: https://api.oproxy.world/v1
{{- if eq .chezmoi.os "darwin" }}
    apiKey: "!security find-generic-password -a \"$USER\" -s omp.oproxy.api-key -w"
{{- else }}
    apiKey: OPROXY_API_KEY
{{- end }}

  anthropic:
    baseUrl: https://api.oproxy.world/v1
{{- if eq .chezmoi.os "darwin" }}
    apiKey: "!security find-generic-password -a \"$USER\" -s omp.oproxy-claude.api-key -w"
{{- else }}
    apiKey: OPROXY_CLAUDE_API_KEY
{{- end }}

  google:
{{- if eq .chezmoi.os "darwin" }}
    apiKey: "!security find-generic-password -a \"$USER\" -s omp.google.api-key -w"
{{- else }}
    apiKey: GOOGLE_API_KEY
{{- end }}

  moonshot:
    baseUrl: https://api.moonshot.cn/v1
{{- if eq .chezmoi.os "darwin" }}
    apiKey: "!security find-generic-password -a \"$USER\" -s omp.moonshot.api-key -w"
{{- else }}
    apiKey: MOONSHOT_API_KEY
{{- end }}

equivalence:
  overrides:
    oproxy/gpt-5.6: gpt-5.6
    oproxy/gpt-5.6-sol: gpt-5.6-sol
    oproxy/gpt-5.6-terra: gpt-5.6-terra
    oproxy/gpt-5.6-luna: gpt-5.6-luna
    oproxy/gpt-5.5: gpt-5.5
    oproxy/gpt-5.4: gpt-5.4
    oproxy/gpt-5.4-mini: gpt-5.4-mini
    oproxy/gpt-5.3-codex: gpt-5.3-codex
    oproxy/gpt-5.3-codex-spark: gpt-5.3-codex-spark
    oproxy/gpt-5.2: gpt-5.2
    oproxy/codex-mini-latest: codex-mini-latest
    oproxy-claude/claude-fable-5: claude-fable-5
    oproxy-claude/claude-opus-4-6: claude-opus-4-6
    oproxy-claude/claude-opus-4-7: claude-opus-4-7
    oproxy-claude/claude-opus-4-8: claude-opus-4-8
    oproxy-claude/claude-opus-5: claude-opus-5
    oproxy-claude/claude-sonnet-4-6: claude-sonnet-4-6
    oproxy-claude/claude-sonnet-5: claude-sonnet-5
