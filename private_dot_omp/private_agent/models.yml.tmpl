# secrets stay machine-local:
# - macOS: Keychain item omp.<provider>.api-key
# - Windows: user env <PROVIDER>_API_KEY (set once; not per-shell)
# - other: env <PROVIDER>_API_KEY
#
# oproxy: OpenAI-compatible third-party relay (https://api.oproxy.world/v1)
# Model limits/costs/capabilities filled from models.dev + pi-catalog metadata.
providers:
  longcat:
    baseUrl: https://api.longcat.chat/openai/v1
{{- if eq .chezmoi.os "darwin" }}
    apiKey: "!security find-generic-password -a \"$USER\" -s omp.longcat.api-key -w"
{{- else }}
    apiKey: LONGCAT_API_KEY
{{- end }}
    api: openai-completions
    authHeader: true
    discovery:
      type: openai-models-list
    models:
      - id: LongCat-2.0
        name: LongCat-2.0
        reasoning: true
        input: [text]
        contextWindow: 1048576
        maxTokens: 131072
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0

  oproxy:
    baseUrl: https://api.oproxy.world/v1
{{- if eq .chezmoi.os "darwin" }}
    apiKey: "!security find-generic-password -a \"$USER\" -s omp.oproxy.api-key -w"
{{- else }}
    apiKey: OPROXY_API_KEY
{{- end }}
    api: openai-completions
    authHeader: true
    # Relay wants store:false; this emits store:false on supported paths.
    # Responses path rejects max_output_tokens on this host.
    compat:
      supportsStore: true
      supportsReasoningEffort: true
      maxTokensField: max_completion_tokens
      supportsDeveloperRole: true
    models:
      # Present on relay /v1/models as of 2026-07-28
      - id: gpt-5.6-sol
        name: GPT-5.6 Sol
        reasoning: true
        input: [text, image]
        contextWindow: 1050000
        maxTokens: 128000
        cost:
          input: 5
          output: 30
          cacheRead: 0.5
          cacheWrite: 6.25
        thinking:
          mode: effort
          efforts: [low, medium, high, xhigh, max]
        compat:
          supportsStore: true

      - id: gpt-5.6-terra
        name: GPT-5.6 Terra
        reasoning: true
        input: [text, image]
        contextWindow: 1050000
        maxTokens: 128000
        cost:
          input: 2.5
          output: 15
          cacheRead: 0.25
          cacheWrite: 3.125
        thinking:
          mode: effort
          efforts: [low, medium, high, xhigh, max]
        compat:
          supportsStore: true

      - id: gpt-5.6-luna
        name: GPT-5.6 Luna
        reasoning: true
        input: [text, image]
        contextWindow: 1050000
        maxTokens: 128000
        cost:
          input: 1
          output: 6
          cacheRead: 0.1
          cacheWrite: 1.25
        thinking:
          mode: effort
          efforts: [low, medium, high, xhigh, max]
        compat:
          supportsStore: true

      - id: gpt-5.5
        name: GPT-5.5
        reasoning: true
        input: [text, image]
        contextWindow: 1050000
        maxTokens: 128000
        cost:
          input: 5
          output: 30
          cacheRead: 0.5
          cacheWrite: 0
        thinking:
          mode: effort
