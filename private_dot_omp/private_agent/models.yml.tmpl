        contextPromotionTarget: oproxy/gpt-5.4
        compat:
          supportsStore: true

      - id: gpt-5.4
        name: GPT-5.4
        reasoning: true
        input: [text, image]
        contextWindow: 1050000
        maxTokens: 128000
        cost:
          input: 2.5
          output: 15
          cacheRead: 0.25
          cacheWrite: 0
        thinking:
          mode: effort
          efforts: [low, medium, high, xhigh]
        compat:
          supportsStore: true

      - id: gpt-5.4-mini
        name: GPT-5.4 Mini
        reasoning: true
        input: [text, image]
        contextWindow: 400000
        maxTokens: 128000
        cost:
          input: 0.75
          output: 4.5
          cacheRead: 0.075
          cacheWrite: 0
        thinking:
          mode: effort
          efforts: [low, medium, high, xhigh]
        compat:
          supportsStore: true

      - id: gpt-5.3-codex-spark
        name: GPT-5.3 Codex Spark
        reasoning: true
