export LANG=zh_CN.UTF-8
export EDITOR=nano
export REACT_EDITOR=idea

# Local proxy (Clash): macOS 6152/6153, Linux 7890
_os="$(uname -s)"
_proxy_http=http://127.0.0.1:6152
_proxy_socks=socks5://127.0.0.1:6153
if [ "$_os" = "Linux" ]; then
  _proxy_http=http://localhost:7890
  _proxy_socks=socks5://localhost:7890
fi
export https_proxy="$_proxy_http"
export http_proxy="$_proxy_http"
export all_proxy="$_proxy_socks"
export NO_PROXY=localhost,127.0.0.1
export ELECTRON_GET_USE_PROXY=true
export GLOBAL_AGENT_HTTPS_PROXY="$_proxy_http"
unset _proxy_http _proxy_socks

path_prepend() {
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1:$PATH" ;;
  esac
}

path_append() {
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$PATH:$1" ;;
  esac
}

path_prepend_if_exists() {
  [ -d "$1" ] && path_prepend "$1"
}

path_append_if_exists() {
  [ -d "$1" ] && path_append "$1"
}

export PROTO_HOME="$HOME/.proto"
export GOPATH="$HOME/go"
export BUN_INSTALL="$HOME/.bun"

case "$_os" in
  Darwin)
    export ANDROID_HOME="$HOME/Library/Android/sdk"
    export PNPM_HOME="$HOME/Library/pnpm"
    ;;
  Linux)
    export ANDROID_HOME="$HOME/Android/Sdk"
    export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
    ;;
esac

for _brew_prefix in /opt/homebrew /home/linuxbrew/.linuxbrew; do
  path_prepend_if_exists "$_brew_prefix/sbin"
  path_prepend_if_exists "$_brew_prefix/bin"
done
unset _brew_prefix
path_prepend_if_exists "/usr/local/sbin"

path_prepend "$HOME/.local/bin"
path_prepend "$HOME/.opencode/bin"
path_prepend "$GOPATH/bin"
path_prepend "$BUN_INSTALL/bin"
path_prepend "$PNPM_HOME"
path_prepend "$PROTO_HOME/bin"
path_prepend "$PROTO_HOME/shims"

# languages / tooling
path_prepend_if_exists "$HOME/.pub-cache/bin"

path_prepend_if_exists "$HOME/.jenv/bin"

case "$_os" in
  Darwin)
    path_prepend_if_exists "/Applications/IntelliJ IDEA.app/Contents/MacOS"
    ;;
  Linux)
    path_prepend_if_exists "$HOME/.local/share/JetBrains/Toolbox/scripts"
    ;;
esac

path_append_if_exists "$ANDROID_HOME/tools"
path_append_if_exists "$ANDROID_HOME/tools/bin"
path_append_if_exists "$ANDROID_HOME/platform-tools"

export PATH

unset _os
unset -f path_prepend path_append path_prepend_if_exists path_append_if_exists
